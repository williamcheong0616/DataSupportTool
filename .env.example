# ==================== Database (PostgreSQL) ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_pipeline

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==================== API Settings ====================
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated, use * for development)
CORS_ORIGINS=http://localhost:5173

# ==================== External Services ====================
# Model endpoint for LLM inference (Ollama, vLLM, etc.)
MODEL_ENDPOINT=http://localhost:8080/v1/completions

# Whisper transcription
WHISPER_API_URL=http://localhost:9000
USE_LOCAL_WHISPER=true

# ==================== Prefect ====================
PREFECT_API_URL=http://localhost:4200/api

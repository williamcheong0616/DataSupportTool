# ==================== Database (PostgreSQL) ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_pipeline

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ==================== API Settings ====================
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins — include both Vite dev server port and production port
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== Whisper ASR ====================
# Set USE_LOCAL_WHISPER=true to use faster-whisper locally (requires torch + GPU/CPU)
# Set USE_LOCAL_WHISPER=false to call an external Whisper HTTP API instead
WHISPER_API_URL=http://localhost:9000
USE_LOCAL_WHISPER=true

# ==================== Ollama ====================
# Ollama base URL and model are configured at runtime via settings.json
# (or through the Settings page in the UI). Defaults:
#   ollama_base_url = http://localhost:11434
#   ollama_model    = gemma3:4b
# You do not need to set anything here for Ollama to work.

# ==================== Provider API (external integrations) ====================
# The key for /api/provider/* routes (lets an external system, e.g. a
# training pipeline, pull verified data over HTTP) is generated and stored
# in settings.json via the Settings page — no server restart needed. Setting
# PROVIDER_API_KEY here only seeds the very first run before settings.json
# has a value; it has no effect afterwards. Usually leave this unset and use
# the "Generate New Key" button in Settings instead.
PROVIDER_API_KEY=

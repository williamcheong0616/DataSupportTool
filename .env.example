# Database (PostgreSQL for production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_pipeline
# For development: DATABASE_URL=sqlite:///./data_pipeline.db

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings
STREAMLIT_PORT=8501

# Model Settings
MODEL_ENDPOINT=http://localhost:8080/v1/completions

# MLflow Settings
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=data_pipeline_validation

# Argilla Settings
ARGILLA_API_URL=http://localhost:6900
ARGILLA_API_KEY=admin.apikey
ARGILLA_WORKSPACE=data_pipeline

# Prefect Settings
PREFECT_API_URL=http://localhost:4200/api
